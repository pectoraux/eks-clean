# ============================================================================
#  Eks-Clean — Environment Variables (template)
#  Copy this file to .env and fill in real values. NEVER commit .env.
# ============================================================================

# PostgreSQL connection string (Neon, Supabase, or any Postgres).
# Use the POOLED connection string here for runtime queries.
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooled) connection string — used by Prisma for migrations.
# Neon requires this because PgBouncer doesn't support all Prisma migration features.
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/dbname?sslmode=require"

# JWT signing secret (HS256). Generate with: openssl rand -hex 32
JWT_SECRET="change_me_to_a_long_random_string"

# Payswap payment gateway
# Leave PAYS_SWAP_API_KEY empty to run in MOCK mode (generates psw_* references).
PAYS_SWAP_API_KEY=""
PAYS_SWAP_BASE_URL="https://api.payswap.example/v1"
PAYS_SWAP_WEBHOOK_SECRET="psw_wh_secret_change_me"

# Realtime (socket.io mini-service). On Vercel this is unavailable —
# the app gracefully degrades (broadcast is best-effort, realtime feed
# shows a "not available" notice). On space-z.ai / local dev, point this
# at the mini-service HTTP API (port 3002).
REALTIME_INTERNAL_URL="http://127.0.0.1:3002"
