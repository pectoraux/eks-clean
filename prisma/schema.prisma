  article         KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([articleId, version])
}

model KbArticleFeedback {
  id              String   @id @default(cuid())
  articleId       String
  userId          String?
  helpful         Boolean
  comment         String?
  createdAt       DateTime @default(now())

  article         KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, helpful])
}

model KbArticleProtocolLink {
  id              String   @id @default(cuid())
  articleId       String
  protocolId      String
  createdAt       DateTime @default(now())

  article         KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, protocolId])
}

model KbArticleServiceLink {
  id              String   @id @default(cuid())
  articleId       String
  serviceTypeId   String
  createdAt       DateTime @default(now())

  article         KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, serviceTypeId])
}

// ----------------------------------------------------------------------------
//  ADVANCED SUBSCRIPTION MANAGEMENT
//  (Pausing, proration, addons, usage tiers, dunning, lifecycle automation)
// ----------------------------------------------------------------------------

model SubscriptionAddon {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?
  priceMinor      Int
  billingCycle    String   @default("MONTHLY") // MONTHLY | ONE_TIME | PER_USE
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   SubscriptionAddonAssignment[]
}

model SubscriptionAddonAssignment {
  id              String   @id @default(cuid())
  subscriptionId  String
  addonId         String
  status          String   @default("ACTIVE") // ACTIVE | REMOVED
  assignedAt      DateTime @default(now())
  removedAt       DateTime?
  prorationMinor  Int      @default(0)

  addon           SubscriptionAddon @relation(fields: [addonId], references: [id])

  @@index([subscriptionId, status])
}

model SubscriptionUsage {
  id              String   @id @default(cuid())
  subscriptionId  String
  periodStart     DateTime
  periodEnd       DateTime
  unitsUsed       Int      @default(0)
  unitsIncluded   Int      @default(0)
  overageMinor    Int      @default(0)
  lastUpdated     DateTime @default(now())

  @@unique([subscriptionId, periodStart])
}

model SubscriptionDunningEvent {
  id              String   @id @default(cuid())
  subscriptionId  String
  attemptNumber   Int
  type            String   // RETRY | PAYMENT_FAILED | GRACE_PERIOD | SUSPENDED | CANCELLED
  scheduledAt     DateTime
  processedAt     DateTime?
  status          String   @default("SCHEDULED") // SCHEDULED | SENT | RESOLVED | EXHAUSTED
  metadataJson    String?
  createdAt       DateTime @default(now())

  @@index([subscriptionId, status])
  @@index([scheduledAt])
}

model SubscriptionPauseSchedule {
  id              String   @id @default(cuid())
  subscriptionId  String
  startDate       DateTime
  endDate         DateTime?
  reason          String?
  autoResume      Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([subscriptionId, startDate])
}

model SubscriptionLifecycleEvent {
  id              String   @id @default(cuid())
  subscriptionId  String
  eventType       String   // CREATED | UPGRADED | DOWNGRADED | PAUSED | RESUMED | CANCELLED | RENEWED | ADDON_ADDED | ADDON_REMOVED | PRORATED | DUNNING_STARTED | DUNNING_RESOLVED
  payloadJson     String?
  actorId         String?
  actorType       String?
  correlationId   String?
  occurredAt      DateTime @default(now())

  @@index([subscriptionId, occurredAt])
  @@index([eventType])
}

// ----------------------------------------------------------------------------
//  COMPREHENSIVE WORKFORCE MANAGEMENT
//  (Skills matrix, performance scoring, schedules, time-off, pay grades)
// ----------------------------------------------------------------------------

model Skill {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  category        String   @default("GENERAL") // CLEANING | SAFETY | EQUIPMENT | CHEMICAL | SOFT_SKILL | DRIVING
  description     String?
  levels          Int      @default(4) // 1..N
  isCertificationRequired Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assessments     SkillAssessment[]
}

model SkillAssessment {
  id              String   @id @default(cuid())
  skillId         String
  workerId        String
  assessorId      String?
  level           Int      // 1..N
  notes           String?
  evidence        String?  // file URLs
  assessedAt      DateTime @default(now())
  expiresAt       DateTime?

  skill           Skill   @relation(fields: [skillId], references: [id])
  worker          Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([skillId, workerId])
  @@index([workerId])
}

model PayGrade {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  baseHourlyMinor Int
  overtimeMultiplier Float  @default(1.5)
  weekendMultiplier Float  @default(1.25)
  holidayMultiplier Float  @default(2.0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments     WorkerPayGradeAssignment[]
}

model WorkerPayGradeAssignment {
  id              String   @id @default(cuid())
  workerId        String
  payGradeId      String
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  assignedBy      String?

  payGrade        PayGrade @relation(fields: [payGradeId], references: [id])
  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, effectiveFrom])
}

model TimeOffRequest {
  id              String   @id @default(cuid())
  workerId        String
  type            String   // VACATION | SICK | PERSONAL | BEREAVEMENT | UNPAID
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          String   @default("PENDING") // PENDING | APPROVED | DENIED | CANCELLED
  reviewedBy      String?
  reviewedAt      DateTime?
  denialReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  worker          Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, status])
  @@index([status, startDate])
}

model ShiftSchedule {
  id              String   @id @default(cuid())
  workerId        String
  date            DateTime
  startTime       String   // "08:00"
  endTime         String   // "17:00"
  type            String   @default("REGULAR") // REGULAR | ON_CALL | OVERTIME | TRAINING
  zone            String?
  status          String   @default("SCHEDULED") // SCHEDULED | CONFIRMED | COMPLETED | NO_SHOW | SWAPPED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  worker          Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date, startTime])
  @@index([date, status])
  @@index([workerId, date])
}

model WorkerPerformanceScore {
  id              String   @id @default(cuid())
  workerId        String
  period          String   // e.g. "2026-07"
  overallScore    Float    // 0..100
  punctualityScore Float
  qualityScore    Float
  productivityScore Float
  customerScore   Float
  teamScore       Float
  trend           String   @default("STABLE") // UP | DOWN | STABLE
  factorsJson     String?
  computedAt      DateTime @default(now())

  worker          Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, period])
  @@index([period, overallScore])
}

// ----------------------------------------------------------------------------
//  EVENT-SOURCED ANALYTICS
//  (Append-only event log + materialized projections)
// ----------------------------------------------------------------------------

model AnalyticsEvent {
  id              String   @id @default(cuid())
  aggregateType   String   // BOOKING | CUSTOMER | WORKER | REVENUE | PROTOCOL | CONTRACT
  aggregateId     String
  eventType       String   // e.g. "booking.completed", "payment.captured"
  version         Int      // monotonic per aggregate
  payloadJson     String
  metadataJson    String?  // { actorId, actorType, ipAddress, userAgent, correlationId }
  occurredAt      DateTime @default(now())
  recordedAt      DateTime @default(now())

  @@index([aggregateType, aggregateId, version])
  @@index([aggregateType, eventType, occurredAt])
  @@index([occurredAt])
}

model AnalyticsProjection {
  id              String   @id @default(cuid())
  projectionName  String   // e.g. "monthly_revenue", "worker_utilization", "customer_retention"
  aggregateKey    String   // e.g. "2026-07" or "worker:abc123"
  valueJson       String   // materialized value
  lastEventId     String?  // last AnalyticsEvent.id processed
  lastEventVersion Int?
  computedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectionName, aggregateKey])
  @@index([projectionName])
}

model AnalyticsQuery {
  id              String   @id @default(cuid())
  name            String
  description     String?
  queryType       String   // TIME_SERIES | COHORT | FUNNEL | TOP_N | COMPARISON
  dataSource      String   // ANALYTICS_EVENT | PROJECTION | DB_VIEW
  configJson      String   // { metric, dimensions, filters, timeRange }
  isPublic        Boolean  @default(false)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([queryType, isPublic])
}

model AnalyticsQueryRun {
  id              String   @id @default(cuid())
  queryId         String?
  queryConfigJson String   // snapshot of the query config at run time
  resultJson      String?
  rowcount        Int      @default(0)
  durationMs      Int      @default(0)
  runBy           String?
  runAt           DateTime @default(now())

  @@index([queryId, runAt])
}

// ----------------------------------------------------------------------------
//  AI-READY DATA STRUCTURES
//  (Prompt templates, model configs, embeddings, agent runs, predictions)
// ----------------------------------------------------------------------------

model AiPromptTemplate {
  id              String   @id @default(cuid())
  key             String   @unique // e.g. "support.triage", "demand.forecast"
  name            String
  description     String?
  systemPrompt    String
  userPromptTemplate String // with {{variables}}
  variablesJson   String   // [{ name, type, required, default }]
  model           String   @default("gpt-4o-mini")
  temperature     Float    @default(0.3)
  maxTokens       Int      @default(1024)
  isActive        Boolean  @default(true)
  version         Int      @default(1)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs            AiAgentRun[]
  embeddings      AiEmbedding[]
}

model AiModelConfig {
  id              String   @id @default(cuid())
  provider        String   // OPENAI | ANTHROPIC | LOCAL | ZAI
  modelId         String
  displayName     String
  contextWindow   Int      @default(128000)
  inputCostPer1kMinor Int  @default(0)
  outputCostPer1kMinor Int @default(0)
  capabilities    String[] @default([]) // TEXT | VISION | FUNCTION_CALLING | JSON_MODE | EMBEDDINGS
  isActive        Boolean  @default(true)
  metadataJson    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, modelId])
}

model AiEmbedding {
  id              String   @id @default(cuid())
  entityType      String   // KB_ARTICLE | CUSTOMER | WORKER | BOOKING | PROTOCOL
  entityId        String
  promptTemplateId String?
  embeddingModel  String   @default("text-embedding-3-small")
  dimensions      Int      @default(1536)
  vectorJson      String   // JSON-serialized Float[] (portable; switch to pgvector later)
  chunkIndex      Int      @default(0)
  chunkText       String
  metadataJson    String?
  createdAt       DateTime @default(now())

  promptTemplate  AiPromptTemplate? @relation(fields: [promptTemplateId], references: [id])

  @@index([entityType, entityId])
  @@index([entityType])
}

model AiAgentRun {
  id              String   @id @default(cuid())
  agentType       String   // SUPPORT_TRIAGE | DISPATCH_OPTIMIZER | DEMAND_FORECAST | QA_PREDICTOR | INVENTORY_FORECAST
  promptTemplateId String?
  triggerEventId  String?  // AnalyticsEvent id that triggered this run
  inputJson       String   // variables + context
  outputJson      String?  // model response
  status          String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | TIMEOUT
  modelUsed       String?
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalCostMinor  Int      @default(0)
  latencyMs       Int      @default(0)
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  promptTemplate  AiPromptTemplate? @relation(fields: [promptTemplateId], references: [id])

  @@index([agentType, status])
  @@index([status, createdAt])
}

model AiPrediction {
  id              String   @id @default(cuid())
  predictionType  String   // DEMAND_FORECAST | CHURN_RISK | QA_SCORE | DISPATCH_OPTIMAL | INVENTORY_REORDER
  entityType      String   // CUSTOMER | WORKER | SERVICE_TYPE | INVENTORY_ITEM | ZONE
  entityId        String
  predictedValue  Float
  confidence      Float    // 0..1
  horizonDays     Int      @default(7)
  modelVersion    String?
  featuresJson    String?
  actualValue     Float?   // populated when the predicted event happens
  accuracyScore   Float?   // populated post-hoc
  generatedAt     DateTime @default(now())
  resolvedAt      DateTime?

  @@index([predictionType, entityType, entityId])
  @@index([generatedAt])
}

model AiWorkflowAdapter {
  id              String   @id @default(cuid())
  workflowActionId String? // optional link to WorkflowAction
  agentType       String
  promptTemplateKey String?
  triggerConditionsJson String?
  outputMappingJson String? // how to map AI output back to entity fields
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([agentType, isActive])
}

// ============================================================================
//  MILESTONE 3 — ARCHITECTURAL FOUNDATIONS
//  1. Multi-Tenancy (Organization → Branch → Area)
//  2. Geographic Intelligence (Country → Region → City → District → Neighborhood → Zone → ServiceArea)
//  3. Property Digital Twin (Property → Room → Surface → Appliance → Furniture → Photo → Timeline)
//  4. Configurable Workflow Engine v2 (Stage → Task → Checklist → RequiredSkill → RequiredProduct → ApprovalRule → QualityGate)
//  5. Dynamic Pricing Engine (PricingRule + PricingFactor + compute function)
// ============================================================================

// ----------------------------------------------------------------------------
//  MULTI-TENANCY
//  Organization is the top-level tenant. Eks-Clean itself is one Organization.
//  Future: other cleaning/laundry/waste/facilities companies become their own Orgs.
// ----------------------------------------------------------------------------

model Organization {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  legalName       String?
  taxId           String?
  billingEmail    String?
  billingPhone    String?
  address         String?
  country         String?
  currency        String   @default("GHS")
  timezone        String   @default("Africa/Accra")
  locale          String   @default("en")
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED | TERMINATED
  plan            String   @default("STARTER") // STARTER | GROWTH | ENTERPRISE
  trialEndsAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branches        Branch[]
  areas           Area[]
  users           User[]
  customers       Customer[]
  workers         Worker[]
  serviceTypes    ServiceType[]
  bookings        Booking[]
  subscriptions   Subscription[]
  inventoryItems  InventoryItem[]
  vehicles        Vehicle[]
  contracts       EnterpriseContract[]
  suppliers       Supplier[]
  geoZones        GeoZone[]
  pricingRules    PricingRule[]
  properties      Property[]
  workflows       WorkflowDefinitionV2[]
}

model Branch {
  id              String   @id @default(cuid())
  organizationId  String
  code            String
  name            String
  address         String?
  phone           String?
  managerUserId   String?  // User id of branch manager
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  areas           Area[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Area {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String?
  code            String
  name            String
  description     String?
  geoZoneId       String?
  managerUserId   String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?     @relation(fields: [branchId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

// ----------------------------------------------------------------------------
//  GEOGRAPHIC INTELLIGENCE
//  Full hierarchy: Country → Region → City → District → Neighborhood → Zone → ServiceArea
//  Plus: TravelPolygon, CoverageRadius, TrafficModel, PricingZone, DemandScore
// ----------------------------------------------------------------------------

model GeoCountry {
  id              String   @id @default(cuid())
  code            String   @unique  // ISO 3166-1 alpha-2 (e.g. "GH")
  name            String
  currency        String   @default("GHS")
  phoneCode       String?  // "+233"
  timezone        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  regions         GeoRegion[]
}

model GeoRegion {
  id              String   @id @default(cuid())
  countryId       String
  code            String
  name            String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  country         GeoCountry @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities          GeoCity[]

  @@unique([countryId, code])
}

model GeoCity {
  id              String   @id @default(cuid())
  regionId        String
  code            String
  name            String
  latitude        Float?
  longitude       Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  region          GeoRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  districts       GeoDistrict[]

  @@unique([regionId, code])
}

model GeoDistrict {
  id              String   @id @default(cuid())
  cityId          String
  code            String
  name            String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  city            GeoCity @relation(fields: [cityId], references: [id], onDelete: Cascade)
  neighborhoods   GeoNeighborhood[]

  @@unique([cityId, code])
}

model GeoNeighborhood {
  id              String   @id @default(cuid())
  districtId      String
  code            String
  name            String
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())

  district        GeoDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)
  zones           GeoZone[]

  @@unique([districtId, code])
}

model GeoZone {
  id              String   @id @default(cuid())
  organizationId  String?
  neighborhoodId  String?
  code            String
  name            String
  description     String?
  // Travel polygon as GeoJSON — array of [lat, lon] coordinates
  polygonJson     String?  // {"type":"Polygon","coordinates":[[[lon,lat],...]]}
  // Coverage radius in km (alternative to polygon)
  coverageRadiusKm Float?
  centerLatitude  Float?
  centerLongitude Float?
  // Traffic model: average speed (km/h) by time-of-day
  trafficModelJson String? // {"off_peak":35,"morning_peak":18,"evening_peak":15,"night":40}
  // Demand score 0..1 for this zone
  demandScore     Float    @default(0.5)
  // Pricing multiplier for this zone (e.g. 1.2 for premium areas)
  pricingMultiplier Float  @default(1.0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  neighborhood    GeoNeighborhood? @relation(fields: [neighborhoodId], references: [id])
  serviceAreas    GeoServiceArea[]

  @@index([organizationId, isActive])
  @@index([neighborhoodId])
}

model GeoServiceArea {
  id              String   @id @default(cuid())
  zoneId          String
  code            String
  name            String
  // Worker assignment rules for this service area
  defaultWorkerPool String? // comma-separated worker ids
  estimatedTravelMin Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  zone            GeoZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, code])
}

// ----------------------------------------------------------------------------
//  PROPERTY DIGITAL TWIN
//  Property → Room → Surface → Appliance → Furniture → Photo → Timeline
//  Replaces/augments the minimal HouseholdProfile
// ----------------------------------------------------------------------------

model Property {
  id              String   @id @default(cuid())
  organizationId  String
  customerId      String
  name            String   // "Main House", "Apartment B"
  propertyType    String   @default("HOUSE") // HOUSE | APARTMENT | OFFICE | STUDIO | TOWNHOUSE | VILLA
  addressId       String?
  geoZoneId       String?
  // Structural
  bedrooms        Int      @default(1)
  bathrooms       Int      @default(1)
  squareMeters    Float?
  floors          Int      @default(1)
  yearBuilt       Int?
  // Characteristics
  hasPets         Boolean  @default(false)
  petDetails      String?
  hasChildren     Boolean  @default(false)
  accessNotes     String?
  parkingAvailable Boolean @default(false)
  // Digital twin metadata
  lastCleanedAt   DateTime?
  nextRecommendedCleanAt DateTime?
  cleanlinessScore Float?  // 0..100, computed from history
  // Config
  preferredProducts String? // comma-separated product ids
  specialInstructions String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rooms           Room[]
  appliances      Appliance[]
  photos          PropertyPhoto[]
  timeline        PropertyTimelineEvent[]
  cleaningHistory PropertyCleaningRecord[]

  @@index([organizationId, customerId])
  @@index([geoZoneId])
}

model Room {
  id              String   @id @default(cuid())
  propertyId      String
  name            String   // "Master Bedroom", "Kitchen"
  roomType        String   @default("BEDROOM") // BEDROOM | BATHROOM | KITCHEN | LIVING_ROOM | DINING | OFFICE | GARAGE | BALCONY | OTHER
  floor           Int      @default(1)
  areaSqM         Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  surfaces        Surface[]
  furniture       Furniture[]

  @@index([propertyId])
}

model Surface {
  id              String   @id @default(cuid())
  roomId          String
  surfaceType     String   // MARBLE | GRANITE | WOOD | LAMINATE | LEATHER | FABRIC | GLASS | TILES | ELECTRONICS | CARPET | OTHER
  location        String?  // "Floor", "Countertop", "Wall"
  areaSqM         Float?
  condition       String   @default("GOOD") // EXCELLENT | GOOD | FAIR | POOR
  lastTreatedAt   DateTime?
  notes           String?
  createdAt       DateTime @default(now())

  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model Furniture {
  id              String   @id @default(cuid())
  roomId          String
  name            String   // "Sofa", "Dining table"
  material        String?  // WOOD | LEATHER | FABRIC | METAL | GLASS
  quantity        Int      @default(1)
  condition       String   @default("GOOD")
  notes           String?
  createdAt       DateTime @default(now())

  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model Appliance {
  id              String   @id @default(cuid())
  propertyId      String
  name            String   // "Refrigerator", "Washing machine"
  brand           String?
  model           String?
  location        String?  // "Kitchen"
  purchaseDate    DateTime?
  lastServicedAt  DateTime?
  warrantyExpiry  DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyPhoto {
  id              String   @id @default(cuid())
  propertyId      String
  roomId          String?
  url             String
  caption         String?
  photoType       String   @default("GENERAL") // GENERAL | BEFORE | AFTER | DAMAGE | INSPECTION
  takenAt         DateTime @default(now())
  takenBy         String?
  createdAt       DateTime @default(now())

  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyTimelineEvent {
  id              String   @id @default(cuid())
  propertyId      String
  eventType       String   // CLEANED | CARPET_CLEANED | LAUNDRY_PICKUP | TRASH_COLLECTED | WINDOW_CLEANED | DEEP_CLEAN | INSPECTION | COMPLAINT | RATING | INVOICE | REPAIR | MAINTENANCE
  title           String
  description     String?
  bookingId       String?
  workerId        String?
  occurredAt      DateTime @default(now())
  metadataJson    String?
  createdAt       DateTime @default(now())

  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, occurredAt])
}

model PropertyCleaningRecord {
  id              String   @id @default(cuid())
  propertyId      String
  bookingId       String?
  cleanedAt       DateTime
  durationMin     Int
  roomsCleaned    Int
  productsUsed    String?  // JSON array of {itemId, quantity}
  issuesFound     String?  // JSON array
  qualityScore    Float?   // 0..100
  notes           String?
  createdAt       DateTime @default(now())

  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, cleanedAt])
}

// ----------------------------------------------------------------------------
//  CONFIGURABLE WORKFLOW ENGINE v2
//  Workflow → Stage → Task → Checklist → RequiredSkill → RequiredProduct → ApprovalRule → QualityGate
// ----------------------------------------------------------------------------

model WorkflowDefinitionV2 {
  id              String   @id @default(cuid())
  organizationId  String
  key             String
  name            String
  description     String?
  serviceTypeId   String?  // optional: bind to a specific service
  entityType      String   @default("BOOKING")
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  estimatedDurationMin Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages          WorkflowStage[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive])
}

model WorkflowStage {
  id              String   @id @default(cuid())
  workflowId      String
  order           Int
  name            String
  description     String?
  stageType       String   @default("EXECUTION") // PREPARATION | EXECUTION | REVIEW | HANDOVER | POST_SERVICE
  estimatedDurationMin Int?
  isRequired      Boolean  @default(true)
  createdAt       DateTime @default(now())

  workflow        WorkflowDefinitionV2 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks           WorkflowTask[]

  @@index([workflowId, order])
}

model WorkflowTask {
  id              String   @id @default(cuid())
  stageId         String
  order           Int
  title           String
  description     String?
  estimatedDurationMin Int?
  isRequired      Boolean  @default(true)
  requiresPhoto   Boolean  @default(false)
  createdAt       DateTime @default(now())

  stage           WorkflowStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  checklists      WorkflowChecklist[]
  requiredSkills  WorkflowRequiredSkill[]
  requiredProducts WorkflowRequiredProduct[]
  approvalRules   WorkflowApprovalRule[]
  qualityGates    WorkflowQualityGate[]

  @@index([stageId, order])
}

model WorkflowChecklist {
  id              String   @id @default(cuid())
  taskId          String
  item            String
  isRequired      Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  task            WorkflowTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model WorkflowRequiredSkill {
  id              String   @id @default(cuid())
  taskId          String
  skillCode       String
  minLevel        Int      @default(1)
  createdAt       DateTime @default(now())

  task            WorkflowTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, skillCode])
}

model WorkflowRequiredProduct {
  id              String   @id @default(cuid())
  taskId          String
  itemId          String?
  productCode     String?  // fallback if item not in inventory
  quantity        Float    @default(1)
  unit            String   @default("UNIT")
  createdAt       DateTime @default(now())

  task            WorkflowTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model WorkflowApprovalRule {
  id              String   @id @default(cuid())
  taskId          String
  approverRole    String   // FIELD_MANAGER | ADMIN | CUSTOMER
  approverUserId  String?
  autoApproveIfScoreGte Float? // auto-approve if quality score ≥ this
  createdAt       DateTime @default(now())

  task            WorkflowTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model WorkflowQualityGate {
  id              String   @id @default(cuid())
  taskId          String
  metric          String   // PHOTO_REQUIRED | CHECKLIST_COMPLETE | QUALITY_SCORE | CUSTOMER_SIGNOFF | DURATION_WITHIN_RANGE
  threshold       Float?
  failureAction   String   @default("BLOCK") // BLOCK | WARN | REWORK
  createdAt       DateTime @default(now())

  task            WorkflowTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ----------------------------------------------------------------------------
//  DYNAMIC PRICING ENGINE
//  PricingRule + PricingFactor → compute dynamic quote
// ----------------------------------------------------------------------------

model PricingRule {
  id              String   @id @default(cuid())
  organizationId  String
  serviceTypeId   String
  name            String
  description     String?
  priority        Int      @default(100) // lower = higher priority
  isActive        Boolean  @default(true)
  // Base
  basePriceMinor  Int
  priceUnit       String   @default("PER_HOUR") // PER_HOUR | PER_JOB | PER_SQ_M | PER_KG
  // Multipliers (all default 1.0 = no change)
  distanceMultiplier Float  @default(1.0)  // applied per km beyond base radius
  distanceBaseKm  Float    @default(10)   // free travel radius
  distancePerKmMinor Int   @default(0)    // charge per km beyond base
  urgencyMultiplier Float  @default(1.0)  // 1.5 for same-day
  demandMultiplier Float   @default(1.0)  // dynamic based on zone demand score
  scarcityMultiplier Float @default(1.0)  // worker scarcity
  subscriptionDiscount Float @default(0.0) // 0.1 = 10% off for subscribers
  promotionMultiplier Float @default(1.0) // 0.9 = 10% promo
  holidayMultiplier Float  @default(1.0)  // 2.0 on holidays
  nightSurchargeMinor Int  @default(0)    // flat surcharge for night jobs
  largePropertyMultiplier Float @default(1.0) // 1.2 for >200 sqm
  largePropertyThreshold Float @default(200) // sqm threshold
  // Effective dates
  validFrom       DateTime?
  validTo         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, serviceTypeId, isActive])
}

model PricingQuote {
  id              String   @id @default(cuid())
  organizationId  String?
  customerId      String?
  serviceTypeId   String?
  propertyId      String?
  bookingId       String?
  basePriceMinor  Int
  distanceChargeMinor Int  @default(0)
  urgencyChargeMinor Int   @default(0)
  demandChargeMinor Int    @default(0)
  scarcityChargeMinor Int  @default(0)
  subscriptionDiscountMinor Int @default(0)
  promotionDiscountMinor Int @default(0)
  holidayChargeMinor Int   @default(0)
  nightSurchargeMinor Int  @default(0)
  largePropertyChargeMinor Int @default(0)
  finalPriceMinor Int
  currency        String   @default("GHS")
  breakdownJson   String   // full breakdown for transparency
  validUntil      DateTime?
  createdAt       DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([bookingId])
}
