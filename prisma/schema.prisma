// ============================================================================
//  OpsOS — Operations Operating System Kernel
//  ============================================================================
//  Domain-independent kernel. No business-specific concepts.
//  Businesses are installed as Protocols via the Protocol SDK.
//
//  Core lifecycle: Demand → Intent → Validation → Policy → Capability →
//    Resource → Scheduling → Routing → Execution Plan → Execution →
//    Observation → Measurement → Learning → Recommendations
//
//  Architecture: Event Sourcing + CQRS + DDD + Plugin Architecture
//  Runtime: Deterministic (RuntimeClock abstraction, no Date.now())
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
//  IDENTITY & ORGANIZATIONS
// ============================================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  phone           String?
  avatarUrl       String?
  status          String   @default("ACTIVE")
  mfaSecret       String?
  mfaEnabled      Boolean  @default(false)
  lastLoginAt     DateTime?
  organizationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  apiKeys         ApiKey[]

  @@index([organizationId])
  @@index([status])
}

model Organization {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  legalName       String?
  currency        String   @default("USD")
  timezone        String   @default("UTC")
  locale          String   @default("en")
  status          String   @default("ACTIVE")
  plan            String   @default("STARTER")
  environment     String   @default("PRODUCTION") // SANDBOX | PRODUCTION
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branches        Branch[]
  users           User[]
  resources       Resource[]
  capabilities    Capability[]
  intents         Intent[]
  executionPlans  ExecutionPlan[]
  workflows       WorkflowDefinition[]
  rules           Rule[]
  policies        Policy[]
  marketplaces    Marketplace[]
  offers          Offer[]
  reservations    Reservation[]
  schedules       Schedule[]
  routes          Route[]
  recommendations Recommendation[]
  projections     Projection[]
  protocols       ProtocolInstallation[]
  extensions      ExtensionInstallation[]
  demands         Demand[]
  events          Event[]
  apiKeys         ApiKey[]
  secrets         Secret[]
  featureFlags    FeatureFlag[]
}

model Branch {
  id              String   @id @default(cuid())
  organizationId  String
  code            String
  name            String
  parentBranchId  String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          Branch?      @relation("BranchHierarchy", fields: [parentBranchId], references: [id])
  children        Branch[]     @relation("BranchHierarchy")

  @@unique([organizationId, code])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model ApiKey {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String?
  name            String
  keyHash         String   @unique
  keyPrefix       String
  scopes          String[] @default([])
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([organizationId])
}

model Secret {
  id              String   @id @default(cuid())
  organizationId  String
  key             String
  encryptedValue  String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, key])
}

model FeatureFlag {
  id              String   @id @default(cuid())
  organizationId  String
  key             String
  description     String?
  enabled         Boolean  @default(false)
  rolloutPercent  Int      @default(0)
  targetRoles     String?
  configJson      String?
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, key])
}

// ============================================================================
//  EVENT STORE — immutable, append-only (CQRS write side)
// ============================================================================

model Event {
  id              String   @id @default(cuid())
  organizationId  String
  aggregateType   String   // RESOURCE | DEMAND | INTENT | EXECUTION_PLAN | WORKFLOW | etc.
  aggregateId     String
  eventType       String
  version         Int      // monotonic per aggregate
  payloadJson     String
  metadataJson    String?  // { actorId, actorType, correlationId, causationId, clockTick }
  occurredAt      DateTime @default(now())
  recordedAt      DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, aggregateType, aggregateId, version])
  @@index([organizationId, eventType, occurredAt])
  @@index([occurredAt])
}

// ============================================================================
//  READ MODELS / PROJECTIONS (CQRS read side)
// ============================================================================

model Projection {
  id              String   @id @default(cuid())
  organizationId  String
  projectionName  String   // e.g. "resource_summary", "demand_pipeline", "execution_metrics"
  aggregateKey    String
  valueJson       String
  lastEventId     String?
  lastEventVersion Int?
  computedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, projectionName, aggregateKey])
  @@index([organizationId, projectionName])
}

// ============================================================================
//  RUNTIME CLOCK — deterministic time abstraction
// ============================================================================

model RuntimeClock {
  id              String   @id @default(cuid())
  organizationId  String
  mode            String   @default("WALL") // WALL | SIMULATION | FIXED
  currentTick     BigInt   @default(0)      // monotonic tick counter
  simulatedTime   DateTime?
  tickDurationMs  Int      @default(1000)   // 1 tick = 1 second by default
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId])
}

// ============================================================================
//  RESOURCES — everything that performs or consumes work
// ============================================================================

model Resource {
  id              String   @id @default(cuid())
  organizationId  String
  code            String
  name            String
  resourceType    String   // WORKER | VEHICLE | EQUIPMENT | INVENTORY | WAREHOUSE | PARTNER | SUPPLIER | ROBOT | IOT_DEVICE | AI_AGENT | EXTERNAL_API
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE | MAINTENANCE | RETIRED
  // Digital twin
  twinJson        String?  // full digital twin snapshot
  metadataJson    String?  // free-form attributes
  // Location
  latitude        Float?
  longitude       Float?
  geoZoneId       String?
  // Hierarchy
  parentResourceId String?
  // Capacity
  capacityJson    String?  // { maxConcurrent, maxPerDay, units, utilization }
  // Ownership
  providerId      String?  // who owns/provides this resource
  costModelJson   String?  // { hourly, perUse, perUnit }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          Resource?    @relation("ResourceHierarchy", fields: [parentResourceId], references: [id])
  children        Resource[]   @relation("ResourceHierarchy")
  capabilities    Capability[]
  reservations    Reservation[]
  schedules       Schedule[]
  routeStops      RouteStop[]

  @@unique([organizationId, code])
  @@index([organizationId, resourceType, status])
}

// ============================================================================
//  CAPABILITY REGISTRY
// ============================================================================

model Capability {
  id              String   @id @default(cuid())
  organizationId  String
  code            String
  name            String
  version         String   @default("1.0.0")
  description     String?
  // Requirements
  requiredResources String? // JSON: types of resources needed
  requiredSkills  String?   // JSON: skill codes + min levels
  constraintsJson String?   // JSON: time, location, capacity constraints
  // Interface
  inputsJson      String?   // JSON: input schema
  outputsJson     String?   // JSON: output schema
  // Economics
  costModelJson   String?   // JSON: { baseCost, perUnit, perMinute }
  qualityMetricsJson String? // JSON: { sla, accuracy, reliability }
  // Runtime
  runtimeMetadataJson String? // JSON: { protocol, extension, handler }
  isActive        Boolean  @default(true)
  protocolId      String?  // which protocol registered this
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource        Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  resourceId      String?

  @@unique([organizationId, code, version])
}

// ============================================================================
//  DEMAND → INTENT → EXECUTION (universal lifecycle)
// ============================================================================

model Demand {
  id              String   @id @default(cuid())
  organizationId  String
  code            String   @unique
  source          String   @default("EXTERNAL") // EXTERNAL | INTERNAL | RECURRING | MARKETPLACE
  // What is being demanded
  capabilityCode  String?  // requested capability
  quantity        Float    @default(1)
  constraintsJson String?  // JSON: time, location, quality, budget
  // Who
  customerId      String?  // requesting entity (protocol-specific)
  // Status in lifecycle
  status          String   @default("DETECTED") // DETECTED | INTENT_CREATED | VALIDATED | PLANNED | EXECUTING | COMPLETED | FAILED | CANCELLED
  priority        String   @default("NORMAL")   // LOW | NORMAL | HIGH | URGENT | CRITICAL
  // Links
  intentId        String?  @unique
  executionPlanId String?  @unique
  // Metadata
  metadataJson    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Relations are defined on the other side (Intent, ExecutionPlan)
  intent          Intent?
  @@index([organizationId, status])
  @@index([organizationId, priority])
}

model Intent {
  id              String   @id @default(cuid())
  organizationId  String
  code            String   @unique
  demandId        String?  @unique
  // Intent definition (from Protocol SDK)
  intentKey       String   // e.g. "schedule_service", "request_quote" — defined by protocol
  intentVersion   String   @default("1.0.0")
  // Compiled intent
  parametersJson  String   // validated input parameters
  // Validation
  validationStatus String  @default("PENDING") // PENDING | VALID | INVALID
  validationErrors String?
  // Policy evaluation
  policyStatus    String   @default("PENDING") // PENDING | ALLOWED | DENIED | CONDITIONAL
  policyDecisionsJson String?
  // Capability resolution
  resolutionStatus String  @default("PENDING") // PENDING | RESOLVED | UNRESOLVED
  resolvedCapabilitiesJson String?
  // Resource allocation
  allocationStatus String  @default("PENDING") // PENDING | ALLOCATED | PARTIAL | FAILED
  allocatedResourcesJson String?
  // Scheduling
  schedulingStatus String  @default("PENDING") // PENDING | SCHEDULED | CONFLICT | FAILED
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  // Routing
  routingStatus   String   @default("PENDING") // PENDING | ROUTED | OPTIMIZED | FAILED
  routeId         String?
  // Execution plan
  planStatus      String   @default("PENDING") // PENDING | PLANNED | FAILED
  executionPlanId String?  @unique
  // Metadata
  protocolId      String?
  metadataJson    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  demand          Demand?      @relation(fields: [demandId], references: [id])
  @@index([organizationId, intentKey, validationStatus])
}

model ExecutionPlan {
  id              String   @id @default(cuid())
  organizationId  String
  code            String   @unique
  intentId        String?  @unique
  demandId        String?  @unique
  // Plan structure
  planJson        String   // full execution plan (stages, tasks, resources, schedule)
  // Execution
  status          String   @default("PLANNED") // PLANNED | APPROVED | EXECUTING | PAUSED | COMPLETED | FAILED | CANCELLED
  // Timeline
  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  // Resources
  allocatedResourcesJson String?
  // Quality
  qualityScore    Float?
  // Financials
  estimatedCostMinor Int   @default(0)
  actualCostMinor Int      @default(0)
  // Determinism
  runtimeTick     BigInt?
  deterministic   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks           Task[]
  observations    Observation[]
  @@index([organizationId, status])
}

model Task {
  id              String   @id @default(cuid())
  executionPlanId String
  order           Int
  title           String
  description     String?
  status          String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED | FAILED
  assignedResourceId String?
  estimatedDurationMin Int?
  actualDurationMin Int?
  requiresPhoto   Boolean  @default(false)
  checklistJson   String?  // [{ item, checked }]
  qualityGatesJson String?
  completionRulesJson String?
  startedAt       DateTime?
  completedAt     DateTime?
  notes           String?
  metadataJson    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executionPlan   ExecutionPlan @relation(fields: [executionPlanId], references: [id], onDelete: Cascade)
  @@index([executionPlanId, order])
}

model Observation {
  id              String   @id @default(cuid())
  executionPlanId String
  taskId          String?
  observedBy      String?
  observationType String   @default("PROGRESS") // PROGRESS | QUALITY | SAFETY | COMPLETION | ISSUE
  value           Float?
  unit            String?
  notes           String?
  photoUrls       String?
  observedAt      DateTime @default(now())
  metadataJson    String?

  executionPlan   ExecutionPlan @relation(fields: [executionPlanId], references: [id], onDelete: Cascade)
  @@index([executionPlanId, observedAt])
}

// ============================================================================
//  WORKFLOW ENGINE — configurable, no hardcoded workflows
// ============================================================================

model WorkflowDefinition {
  id              String   @id @default(cuid())
  organizationId  String
  key             String
  name            String
  description     String?
  entityType      String   @default("EXECUTION_PLAN")
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  stagesJson      String   // [{ order, name, type, tasks: [{ title, checklist, qualityGates, requiredSkills, requiredResources }] }]
  approvalRulesJson String?
  completionRulesJson String?
  estimatedDurationMin Int?
  protocolId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, key])
  @@index([organizationId, isActive])
}

// ============================================================================
//  RULES ENGINE — declarative business behavior
// ============================================================================

model Rule {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  triggerEvent    String   // event type that fires this rule
  triggerType     String   @default("EVENT") // EVENT | SCHEDULED | MANUAL
  priority        Int      @default(100)
  isActive        Boolean  @default(true)
  maxExecutionsPerDay Int  @default(0)
  cooldownMinutes Int      @default(0)
  // Conditions + Actions (stored as JSON for flexibility)
  conditionsJson  String   // [{ field, operator, value, logicOperator }]
  actionsJson     String   // [{ actionType, config, isAsync }]
  scope           String   @default("ORGANIZATION")
  scopeId         String?
  protocolId      String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions      RuleExecution[]
  @@index([organizationId, isActive, priority])
  @@index([triggerEvent, isActive])
}

model RuleExecution {
  id              String   @id @default(cuid())
  ruleId          String
  triggerEventId  String?
  entityType      String?
  entityId        String?
  status          String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | SKIPPED
  conditionsMatched Boolean @default(false)
  actionsExecutedJson String?
  errorMessage    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?
  triggeredBy     String?
  metadataJson    String?

  rule            Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  @@index([ruleId, status])
}

// ============================================================================
//  POLICY ENGINE — access control + business policies
// ============================================================================

model Policy {
  id              String   @id @default(cuid())
  organizationId  String
  key             String
  name            String
  description     String?
  policyType      String   @default("ACCESS") // ACCESS | BUSINESS | COMPLIANCE | ECONOMIC
  effect          String   @default("ALLOW")  // ALLOW | DENY | CONDITIONAL
  conditionsJson  String?  // when this policy applies
  actionsJson     String?  // what to do
  priority        Int      @default(100)
  isActive        Boolean  @default(true)
  protocolId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, key])
}

// ============================================================================
//  SCHEDULING ENGINE
// ============================================================================

model Schedule {
  id              String   @id @default(cuid())
  organizationId  String
  resourceId      String
  scheduleType    String   @default("AVAILABILITY") // AVAILABILITY | BOOKING | MAINTENANCE | BREAK
  dayOfWeek       Int?     // 0..6 for recurring
  specificDate    DateTime? // for one-time
  startTime       String   // "08:00"
  endTime         String   // "17:00"
  recurrenceJson  String?  // iCal-style recurrence rules
  capacityJson    String?  // { maxConcurrent, units }
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource        Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  @@index([resourceId, specificDate])
}

// ============================================================================
//  ROUTING ENGINE
// ============================================================================

model Route {
  id              String   @id @default(cuid())
  organizationId  String
  code            String   @unique
  resourceId      String?
  executionPlanId String?
  status          String   @default("PLANNED") // PLANNED | OPTIMIZED | ACTIVE | COMPLETED
  totalDistanceKm Float?
  totalDurationMin Int?
  totalStops      Int       @default(0)
  optimizedJson   String?   // optimization metadata (algorithm, alternatives, trade-offs)
  // Decision provenance
  alternativesJson String?  // other routes considered
  tradeoffsJson   String?   // time vs cost vs quality trade-offs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stops           RouteStop[]
  @@index([organizationId, status])
}

model RouteStop {
  id              String   @id @default(cuid())
  routeId         String
  order           Int
  resourceId      String?
  latitude        Float?
  longitude       Float?
  estimatedArrival DateTime?
  actualArrival   DateTime?
  durationMin     Int?
  status          String   @default("PENDING") // PENDING | ARRIVED | COMPLETED | SKIPPED
  metadataJson    String?

  route           Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  resource        Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  @@index([routeId, order])
}

// ============================================================================
//  MARKETPLACE ENGINE — generic capacity trading
// ============================================================================

model Marketplace {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  marketplaceType String   @default("INTERNAL") // INTERNAL | EXTERNAL | HYBRID
  optimizationGoals String[] @default(["QUALITY", "COST"]) // QUALITY | COST | LATENCY | UTILIZATION | COVERAGE
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offers          Offer[]
  @@index([organizationId, isActive])
}

model Offer {
  id              String   @id @default(cuid())
  organizationId  String
  marketplaceId   String
  providerId      String?  // resource or external provider
  capabilityCode  String
  capacityJson    String   // { units, startTime, endTime, location }
  priceMinor      Int
  currency        String   @default("USD")
  qualityScore    Float?   // 0..100
  confidenceScore Float?   // 0..1
  status          String   @default("OPEN") // OPEN | RESERVED | FULFILLED | EXPIRED | CANCELLED
  expiresAt       DateTime?
  metadataJson    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplace     Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  reservations    Reservation[]
  @@index([marketplaceId, status])
}

model Reservation {
  id              String   @id @default(cuid())
  organizationId  String
  offerId         String
  resourceId      String?
  demandId        String?
  status          String   @default("PENDING") // PENDING | CONFIRMED | RELEASED | FULFILLED
  quantity        Float    @default(1)
  reservedAt      DateTime @default(now())
  confirmedAt     DateTime?
  releasedAt      DateTime?
  metadataJson    String?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offer           Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  resource        Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  @@index([offerId, status])
}

// ============================================================================
//  RECOMMENDATION ENGINE — immutable, evidence-based
// ============================================================================

model Recommendation {
  id              String   @id @default(cuid())
  organizationId  String
  recommendationType String // DEMAND_FORECAST | RESOURCE_OPTIMIZATION | PRICING | SCHEDULING | QUALITY | RETENTION
  entityType      String   // RESOURCE | DEMAND | INTENT | EXECUTION_PLAN
  entityId        String?
  title           String
  description     String?
  // Lifecycle
  status          String   @default("DETECTED") // DETECTED | SCORED | SIMULATED | RECOMMENDED | ACCEPTED | IMPLEMENTED | OBSERVED | MEASURED | LEARNED
  // Evidence
  evidenceJson    String?  // supporting data
  confidence      Float    @default(0.5) // 0..1
  expectedImpactJson String? // { metric, delta, timeframe }
  simulationJson  String?  // simulation results
  explanation     String?  // human-readable explanation
  // Resolution
  acceptedAt      DateTime?
  implementedAt   DateTime?
  observedAt      DateTime?
  actualImpactJson String?
  accuracyScore   Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, recommendationType, status])
  @@index([organizationId, entityType, entityId])
}

// ============================================================================
//  PROTOCOL SDK — protocol registration + installation
// ============================================================================

model ProtocolInstallation {
  id              String   @id @default(cuid())
  organizationId  String
  protocolKey     String   // e.g. "eks-clean", "eks-laundry"
  protocolVersion String
  name            String
  description     String?
  // What the protocol registered
  capabilitiesJson    String? // list of capability codes
  intentDefinitionsJson String?
  policiesJson    String?
  rulesJson       String?
  workflowsJson   String?
  marketplaceJson String?
  pricingJson     String?
  dashboardsJson  String?
  readModelsJson  String?
  analyticsJson   String?
  apiEndpointsJson String?
  uiComponentsJson String?
  compilerStagesJson String?
  // Status
  status          String   @default("INSTALLED") // INSTALLED | ACTIVE | SUSPENDED | UNINSTALLED
  installedAt     DateTime @default(now())
  activatedAt     DateTime?
  configurationJson String?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, protocolKey])
  @@index([organizationId, status])
}

// ============================================================================
//  EXTENSION SDK — extension registration
// ============================================================================

model ExtensionInstallation {
  id              String   @id @default(cuid())
  organizationId  String
  extensionKey    String
  extensionVersion String
  name            String
  description     String?
  // What the extension registered
  compilerStagesJson String?
  dashboardsJson  String?
  analyticsJson   String?
  inspectorPanelsJson String?
  recommendationAnalyzersJson String?
  integrationsJson String?
  widgetsJson     String?
  apiEndpointsJson String?
  uiComponentsJson String?
  status          String   @default("INSTALLED")
  installedAt     DateTime @default(now())
  configurationJson String?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, extensionKey])
}

// ============================================================================
//  AUDIT LOG
// ============================================================================

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  organizationId  String?
  action          String
  resourceType    String?
  resourceId      String?
  beforeJson      String?
  afterJson       String?
  ipAddress       String?
  userAgent       String?
  outcome         String   @default("SUCCESS")
  reason          String?
  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([action])
}

// ============================================================================
//  NOTIFICATIONS
// ============================================================================

model Notification {
  id              String   @id @default(cuid())
  userId          String?
  organizationId  String?
  type            String
  title           String
  body            String?
  dataJson        String?
  readAt          DateTime?
  createdAt       DateTime @default(now())
  @@index([userId, readAt])
}
