// ============================================================================
//  Eks-Clean — Household Services Operating System
//  Database Schema (SQLite for dev; designed for PostgreSQL portability)
//  Conventions:
//   - Soft-delete via `deletedAt DateTime?`
//   - Audit via AuditLog entries (write-side)
//   - All money fields stored as integer minor units (e.g. pesewas/cents)
//   - All ids are cuid() strings
//   - Enums are stored as String for SQLite compatibility; values are typed
//     in src/lib/types/*.ts and validated with zod.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
//  AUTH & IDENTITY
// ============================================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  phone           String?
  avatarUrl       String?
  role            String   @default("CUSTOMER") // CUSTOMER | WORKER | FIELD_MANAGER | SALES_AGENT | ADMIN
  status          String   @default("ACTIVE")   // ACTIVE | SUSPENDED | DELETED | PENDING
  mfaSecret       String?                       // MFA-ready (TOTP secret)
  mfaEnabled      Boolean  @default(false)
  lastLoginAt     DateTime?
  failedLoginCount Int     @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  customer        Customer?
  worker          Worker?
  fieldManager    FieldManager?
  salesAgent      SalesAgent?

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. bookings:create, workers:approve
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId      String
  permissionId String
  role        String   // CUSTOMER | WORKER | FIELD_MANAGER | SALES_AGENT | ADMIN
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ============================================================================
//  CUSTOMERS
// ============================================================================

model Customer {
  id              String   @id @default(cuid())
  userId          String   @unique
  payswapCustomerId String? // Payment gateway reference (never store cards)
  preferredLanguage String? @default("en")
  marketingOptIn  Boolean  @default(true)
  loyaltyPoints   Int      @default(0)
  customerTier    String   @default("STANDARD") // STANDARD | SILVER | GOLD | PLATINUM
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses       Address[]
  householdProfiles HouseholdProfile[]
  bookings        Booking[]
  subscriptions   Subscription[]
  ratings         Rating[]
  favorites       FavoriteWorker[]
  supportTickets  SupportTicket[]
  // CRM + Enterprise relations
  crmTouchpoints  CrmTouchpoint[]
  crmDeals        CrmDeal[]
  healthScore     CustomerHealthScore?
  journeyStages   CustomerJourneyStage[]
  contracts       EnterpriseContract[]
  segmentMemberships CrmSegmentMembership[]

  @@index([customerTier])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  label       String   @default("Home") // Home | Work | Other
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String?
  country     String   @default("Ghana")
  latitude    Float?
  longitude   Float?
  instructions String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([customerId])
}

model HouseholdProfile {
  id          String   @id @default(cuid())
  customerId  String
  name        String   // e.g. "Main House", "Apartment B"
  propertyType String? // APARTMENT | HOUSE | OFFICE | STUDIO
  bedrooms    Int      @default(1)
  bathrooms   Int      @default(1)
  squareMeters Float?
  hasPets     Boolean  @default(false)
  petDetails  String?
  hasChildren Boolean  @default(false)
  accessNotes String?
  parkingAvailable Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([customerId])
}

model FavoriteWorker {
  id          String   @id @default(cuid())
  customerId  String
  workerId    String
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([customerId, workerId])
}

// ============================================================================
//  WORKERS
// ============================================================================

model Worker {
  id                String   @id @default(cuid())
  userId            String   @unique
  employeeId        String?  @unique
  payswapAccountId  String?  // Connected account reference
  status            String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED | TERMINATED
  onboardingStep    String   @default("PROFILE") // PROFILE | KYC | SKILLS | TRAINING | EQUIPMENT | LIVE
  kycStatus         String   @default("NOT_SUBMITTED") // NOT_SUBMITTED | PENDING | VERIFIED | REJECTED
  kycSubmittedAt    DateTime?
  kycVerifiedAt     DateTime?
  averageRating     Float    @default(0)
  totalRatings      Int      @default(0)
  completedJobs     Int      @default(0)
  cancelledJobs     Int      @default(0)
  utilizationRate   Float    @default(0) // 0..1 weekly utilization
  homeLatitude      Float?
  homeLongitude     Float?
  preferredRadiusKm Int      @default(15)
  bankAccountRef    String?
  emergencyContact  String?
  hireDate          DateTime?
  terminationDate   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            WorkerSkill[]
  certifications    WorkerCertification[]
  trainingRecords   TrainingRecord[]
  availabilities    WorkerAvailability[]
  ratings           Rating[]
  favorites         FavoriteWorker[]
  inventoryItems    WorkerInventoryItem[]
  attendance        WorkerAttendance[]
  performanceReviews PerformanceReview[]
  assignments       WorkerAssignment[]
  payouts           Payout[]
  qualityAudits     QualityAudit[]
  // LMS + Protocol + Fleet relations
  protocolExecutions ProtocolExecution[]
  enrollments      Enrollment[]
  lmsCertifications Certification[]

  @@index([status])
  @@index([kycStatus])
}

model WorkerSkill {
  id          String   @id @default(cuid())
  workerId    String
  skillCode   String   // e.g. CARPET_CLEANING, WINDOW_CLEANING
  proficiency String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT
  certifiedAt DateTime?
  createdAt   DateTime @default(now())

  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, skillCode])
  @@index([skillCode])
}

model WorkerCertification {
  id          String   @id @default(cuid())
  workerId    String
  type        String   // SURFACE | CHEMICAL | EQUIPMENT | SAFETY
  name        String   // e.g. "Marble Surface Care"
  issuedBy    String?
  issuedAt    DateTime
  expiresAt   DateTime?
  status      String   @default("ACTIVE") // ACTIVE | EXPIRED | REVOKED
  documentUrl String?
  createdAt   DateTime @default(now())

  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, type])
  @@index([expiresAt])
}

model TrainingRecord {
  id          String   @id @default(cuid())
  workerId    String
  moduleId    String
  moduleName  String
  startedAt   DateTime?
  completedAt DateTime?
  examScore   Float?
  attempts    Int      @default(0)
  status      String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | PASSED | FAILED
  certSurface String?  // surface category certified
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, status])
}

model WorkerAvailability {
  id          String   @id @default(cuid())
  workerId    String
  dayOfWeek   Int      // 0=Sun .. 6=Sat
  startTime   String   // "08:00"
  endTime     String   // "17:00"
  isAvailable Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?

  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
}

model WorkerAttendance {
  id          String   @id @default(cuid())
  workerId    String
  date        DateTime
  checkInAt   DateTime?
  checkOutAt  DateTime?
  status      String   @default("SCHEDULED") // SCHEDULED | PRESENT | LATE | ABSENT | LEAVE
  notes       String?
  createdAt   DateTime @default(now())

  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
}

model PerformanceReview {
  id          String   @id @default(cuid())
  workerId    String
  reviewerId  String   // FieldManager userId
  period      String   // e.g. "2026-Q3"
  rating      Float    // 1..5
  strengths   String?
  improvements String?
  goals       String?
  createdAt   DateTime @default(now())

  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
}

model WorkerAssignment {
  id          String   @id @default(cuid())
  workerId    String
  bookingId   String
  assignedBy  String   // user id of manager/system
  assignedAt  DateTime @default(now())
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  status      String   @default("OFFERED") // OFFERED | ACCEPTED | REJECTED | EXPIRED | REASSIGNED
  routeOrder  Int?
  estimatedTravelMinutes Int?

  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([workerId, status])
  @@index([bookingId])
}

// ============================================================================
//  FIELD MANAGERS
// ============================================================================

model FieldManager {
  id              String   @id @default(cuid())
  userId          String   @unique
  region          String?  // assigned territory
  managedWorkerCount Int   @default(0)
  hireDate        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audits          QualityAudit[]
}

// ============================================================================
//  SALES AGENTS
// ============================================================================

model SalesAgent {
  id              String   @id @default(cuid())
  userId          String   @unique
  territory       String?
  referralCode    String   @unique
  commissionRate  Float    @default(0.05) // 5%
  totalLeads      Int      @default(0)
  convertedLeads  Int      @default(0)
  totalCommissionMinor Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads           Lead[]

  @@index([territory])
}

model Lead {
  id              String   @id @default(cuid())
  salesAgentId    String?
  name            String
  phone           String
  email           String?
  address         String?
  source          String   @default("DOOR_TO_DOOR") // DOOR_TO_DOOR | REFERRAL | SOCIAL | OTHER
  status          String   @default("NEW") // NEW | CONTACTED | INTERESTED | CONVERTED | LOST
  notes           String?
  convertedCustomerId String?
  commissionCreditedMinor Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  salesAgent      SalesAgent? @relation(fields: [salesAgentId], references: [id], onDelete: SetNull)

  @@index([salesAgentId, status])
}

// ============================================================================
//  SERVICE CATALOG
// ============================================================================

model ServiceType {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. HOME_CLEANING
  name            String
  description     String?
  category        String   @default("GENERAL") // CLEANING | LAUNDRY | WASTE | DETAILING
  basePriceMinor  Int      // base price in minor units
  priceUnit       String   @default("PER_HOUR") // PER_HOUR | PER_JOB | PER_SQ_M | PER_KG
  estimatedDurationMin Int
  iconUrl         String?
  isActive        Boolean  @default(true)
  requiresCertification String? // comma-separated skill codes required
  configJson      String?  // free-form JSON config (no code changes to add services)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings        Booking[]
  subscriptionPlans SubscriptionPlan[]
  inventoryItems  InventoryItem[]
  // Protocol + Contract relations
  protocols       CleaningProtocol[]
  contractLines   ContractLine[]

  @@index([category, isActive])
}

// ============================================================================
//  BOOKING ENGINE
// ============================================================================

model Booking {
  id              String   @id @default(cuid())
  code            String   @unique // human-friendly e.g. EKS-2026-001234
  customerId      String
  serviceTypeId   String
  addressId       String
  householdProfileId String?
  status          String   @default("REQUESTED")
  // draft | requested | assigned | worker_accepted | worker_en_route | arrived
  // | in_progress | completed | rated | cancelled | disputed
  scheduledStart  DateTime
  scheduledEnd    DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  workerCount     Int      @default(1)
  notes           String?
  photoUrls       String?  // JSON array of URLs
  priceMinor      Int
  discountMinor   Int      @default(0)
  totalMinor      Int
  currency        String   @default("GHS")
  cancellationReason String?
  disputeReason   String?
  disputeStatus   String?
  source          String   @default("WEB") // WEB | MOBILE | AGENT | RECURRING
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceType     ServiceType  @relation(fields: [serviceTypeId], references: [id])
  address         Address      @relation(fields: [addressId], references: [id])
  householdProfile HouseholdProfile? @relation(fields: [householdProfileId], references: [id])
  assignments     WorkerAssignment[]
  ratings         Rating[]
  qualityAudits   QualityAudit[]
  laundryOrders   LaundryOrder[]
  statusHistory   BookingStatusHistory[]
  paymentIntents  PaymentIntent[]
  events          DomainEvent[]

  @@index([customerId, status])
  @@index([serviceTypeId, status])
  @@index([scheduledStart])
  @@index([status])
}

model BookingStatusHistory {
  id          String   @id @default(cuid())
  bookingId   String
  fromStatus  String?
  toStatus    String
  reason      String?
  actorId     String?  // user id
  actorType   String?  // SYSTEM | CUSTOMER | WORKER | MANAGER
  metadataJson String?
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

// ============================================================================
//  QUALITY MANAGEMENT
// ============================================================================

model Rating {
  id              String   @id @default(cuid())
  bookingId       String
  customerId      String
  workerId        String
  punctuality     Int      // 1..5
  professionalism Int
  cleanliness     Int
  friendliness    Int
  overall         Int
  comment         String?
  photoUrls       String?  // JSON array
  flagged         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([bookingId])
  @@index([workerId])
}

model QualityAudit {
  id              String   @id @default(cuid())
  bookingId       String?
  workerId        String
  auditorId       String   // FieldManager id
  score           Float    // 0..100
  punctualityOk   Boolean  @default(true)
  uniformOk       Boolean  @default(true)
  equipmentOk     Boolean  @default(true)
  chemicalUsageOk Boolean  @default(true)
  customerInteractionOk Boolean @default(true)
  findings        String?
  photoUrls       String?  // JSON array
  actionRequired  String?
  followUpDate    DateTime?
  createdAt       DateTime @default(now())

  booking         Booking? @relation(fields: [bookingId], references: [id])
  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  auditor         FieldManager @relation(fields: [auditorId], references: [id])

  @@index([workerId])
}

// ============================================================================
//  SUBSCRIPTIONS
// ============================================================================

model SubscriptionPlan {
  id              String   @id @default(cuid())
  serviceTypeId   String
  name            String   // e.g. "Weekly Home Cleaning"
  cadence         String   // WEEKLY | BIWEEKLY | MONTHLY | CUSTOM
  cadenceDays     Int      // interval in days (7, 14, 30, etc.)
  billingPriceMinor Int
  discountPercent Float    @default(0.1) // 10% off vs single bookings
  description     String?
  isActive        Boolean  @default(true)
  payswapPriceId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  serviceType     ServiceType @relation(fields: [serviceTypeId], references: [id])
  subscriptions   Subscription[]

  @@index([serviceTypeId, isActive])
}

model Subscription {
  id              String   @id @default(cuid())
  customerId      String
  planId          String
  payswapSubscriptionId String?
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED | EXPIRED | PAST_DUE
  startDate       DateTime @default(now())
  endDate         DateTime?
  nextBillingDate DateTime?
  pausedAt        DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  autoRenew       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([customerId, status])
  @@index([status])
}

// ============================================================================
//  INVENTORY
// ============================================================================

model InventoryItem {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  category        String   // CHEMICAL | TOOL | EQUIPMENT | PPE | VEHICLE | CONSUMABLE
  description     String?
  unit            String   @default("UNIT") // LITER | KG | UNIT | BOX
  reorderLevel    Int      @default(10)
  hazardLevel     String?  // LOW | MEDIUM | HIGH
  ppeRequired     String?  // comma-separated
  approvedSurfaces String? // comma-separated surface codes (for chemicals)
  mixingInstructions String?
  replacementRecommendation String?
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  serviceTypes    ServiceType[]
  warehouseStock  WarehouseStock[]
  workerStock     WorkerInventoryItem[]
  movements       InventoryMovement[]
  // SCM + Protocol relations
  poLines         PurchaseOrderLine[]
  receiptLines    GoodsReceiptLine[]
  protocolStepChemicals ProtocolStepChemical[]
}

model WarehouseStock {
  id              String   @id @default(cuid())
  itemId          String
  warehouseCode   String   @default("MAIN")
  quantity        Int      @default(0)
  reservedQty     Int      @default(0)
  updatedAt       DateTime @updatedAt

  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseCode])
}

model WorkerInventoryItem {
  id              String   @id @default(cuid())
  workerId        String
  itemId          String
  quantity        Int      @default(0)
  issuedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  worker          Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([workerId, itemId])
}

model InventoryMovement {
  id              String   @id @default(cuid())
  itemId          String
  fromLocation    String?  // warehouse code or worker id
  toLocation      String?
  quantity        Int      // negative = outflow
  reason          String   // ISSUED | RETURNED | CONSUMED | RESTOCK | LOST | DAMAGED
  referenceId     String?  // booking id / restock order
  performedBy     String?  // user id
  createdAt       DateTime @default(now())

  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

// ============================================================================
//  LAUNDRY
// ============================================================================

model LaundryOrder {
  id              String   @id @default(cuid())
  bookingId       String
  pickupAt        DateTime?
  sortedAt        DateTime?
  washedAt        DateTime?
  driedAt         DateTime?
  ironedAt        DateTime?
  packedAt        DateTime?
  deliveredAt     DateTime?
  totalGarments   Int      @default(0)
  totalWeightKg   Float?
  status          String   @default("PICKUP_PENDING")
  // PICKUP_PENDING | SORTED | WASHING | DRYING | IRONING | PACKED | DELIVERED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  garments        LaundryGarment[]

  @@index([status])
}

model LaundryGarment {
  id              String   @id @default(cuid())
  orderId         String
  barcode         String   @unique
  garmentType     String   // SHIRT | TROUSER | DRESS | SHEET | OTHER
  color           String?
  material        String?
  treatment       String?  // WASH_ONLY | DRY_CLEAN | IRON_ONLY
  status          String   @default("RECEIVED")
  photoUrl        String?
  createdAt       DateTime @default(now())

  order           LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ============================================================================
//  WASTE COLLECTION
// ============================================================================

model WasteSchedule {
  id              String   @id @default(cuid())
  zoneCode        String
  routeCode       String?
  pickupDay       Int      // 0..6
  pickupWindow    String   // "06:00-10:00"
  wasteCategories String   // comma-separated: ORGANIC | RECYCLABLE | GENERAL | HAZARDOUS
  truckId         String?
  driverWorkerId  String?
  subscriptionId  String?
  nextPickupDate  DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([zoneCode, isActive])
}

model WastePickupLog {
  id              String   @id @default(cuid())
  scheduleId      String
  actualPickupAt  DateTime
  volumeKg        Float?
  categoriesCollected String?
  photoUrl        String?
  notes           String?
  reportedBy      String?
  createdAt       DateTime @default(now())

  @@index([scheduleId, actualPickupAt])
}

// ============================================================================
//  PAYMENTS (References only — never store card/bank details)
// ============================================================================

model PaymentIntent {
  id              String   @id @default(cuid())
  bookingId       String?
  customerId      String?
  payswapPaymentIntentId String? @unique
  payswapCheckoutSessionId String?
  amountMinor     Int
  currency        String   @default("GHS")
  status          String   @default("REQUIRES_PAYMENT_METHOD")
  // REQUIRES_PAYMENT_METHOD | REQUIRES_ACTION | PROCESSING | SUCCEEDED | CANCELLED | FAILED
  description     String?
  metadataJson    String?
  capturedAt      DateTime?
  refundedAmountMinor Int  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking         Booking? @relation(fields: [bookingId], references: [id])

  @@index([customerId, status])
  @@index([status])
}

model Payout {
  id              String   @id @default(cuid())
  workerId        String
  periodStart     DateTime
  periodEnd       DateTime
  grossAmountMinor Int
  platformFeeMinor Int
  netAmountMinor  Int
  payswapTransferId String?
  status          String   @default("PENDING") // PENDING | IN_TRANSIT | PAID | FAILED
  lineItemsJson   String?  // breakdown of bookings
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, status])
}

model Invoice {
  id              String   @id @default(cuid())
  customerId      String?
  subscriptionId  String?
  payswapInvoiceId String? @unique
  number          String?  @unique
  amountMinor     Int
  currency        String   @default("GHS")
  status          String   @default("OPEN") // DRAFT | OPEN | PAID | VOID | UNCOLLECTIBLE
  dueDate         DateTime?
  paidAt          DateTime?
  pdfUrl          String?
  hostedUrl       String?
  lineItemsJson   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId, status])
}

model PaymentWebhookEvent {
  id              String   @id @default(cuid())
  payswapEventId  String   @unique
  type            String   // e.g. payment_intent.succeeded
  payloadJson     String
  signature       String?
  verified        Boolean  @default(false)
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime @default(now())

  @@index([type, verified])
}

// ============================================================================
//  EVENTS (Event-driven architecture)
// ============================================================================

model DomainEvent {
  id              String   @id @default(cuid())
  bookingId       String?
  eventType       String   // e.g. booking.created, worker.assigned, payment.captured
  payloadJson     String
  actorId         String?
  actorType       String?
  correlationId   String?
  occurredAt      DateTime @default(now())

  booking         Booking? @relation(fields: [bookingId], references: [id])

  @@index([eventType, occurredAt])
  @@index([correlationId])
}

// ============================================================================
//  AUDIT & SECURITY
// ============================================================================

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String   // e.g. user.login, customer.create, booking.cancel
  resourceType    String?
  resourceId      String?
  beforeJson      String?
  afterJson       String?
  ipAddress       String?
  userAgent       String?
  outcome         String   @default("SUCCESS") // SUCCESS | FAILURE | DENIED
  reason          String?
  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action])
  @@index([resourceType, resourceId])
}

model FeatureFlag {
  id              String   @id @default(cuid())
  key             String   @unique
  description     String?
  enabled         Boolean  @default(false)
  rolloutPercent  Int      @default(0)
  targetRoles     String?  // comma-separated roles
  configJson      String?
  updatedAt       DateTime @updatedAt
}

model RateLimitBucket {
  id              String   @id @default(cuid())
  bucketKey       String   @unique // e.g. "ip:1.2.3.3:login"
  tokens          Int
  maxTokens       Int
  refillPerSec    Int
  lastRefillAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
//  NOTIFICATIONS & SUPPORT
// ============================================================================

model Notification {
  id              String   @id @default(cuid())
  userId          String
  type            String   // BOOKING_UPDATE | PAYMENT | MARKETING | SYSTEM
  title           String
  body            String?
  dataJson        String?
  readAt          DateTime?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model SupportTicket {
  id              String   @id @default(cuid())
  customerId      String
  subject         String
  description     String
  status          String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority        String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assignedTo      String?
  resolution      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
}

// ============================================================================
//  ADVANCED CRM
// ============================================================================

model CrmSegment {
  id              String   @id @default(cuid())
  name            String
  description     String?
  rulesJson       String   // JSON: [{ field, op, value }] — evaluated against Customer
  isDynamic       Boolean  @default(true)
  memberCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaigns       CrmCampaign[]
  memberships     CrmSegmentMembership[]

  @@index([name])
}

model CrmSegmentMembership {
  id              String   @id @default(cuid())
  segmentId       String
  customerId      String
  addedAt         DateTime @default(now())
  reason          String?

  segment         CrmSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customer        Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([segmentId, customerId])
  @@index([customerId])
}

model CrmCampaign {
  id              String   @id @default(cuid())
  name            String
  type            String   // EMAIL | SMS | PUSH | CALL | MIXED
  status          String   @default("DRAFT") // DRAFT | SCHEDULED | RUNNING | PAUSED | COMPLETED | CANCELLED
  channel         String
  audienceSegmentId String?
  startDate       DateTime?
  endDate         DateTime?
  sentCount       Int      @default(0)
  openCount       Int      @default(0)
  clickCount      Int      @default(0)
  conversionCount Int      @default(0)
  templateJson    String?
  budgetMinor     Int      @default(0)
  spentMinor      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  segment         CrmSegment? @relation(fields: [audienceSegmentId], references: [id])
  touchpoints     CrmTouchpoint[]

  @@index([status])
}

model CrmTouchpoint {
  id              String   @id @default(cuid())
  customerId      String
  campaignId      String?
  channel         String   // EMAIL | SMS | CALL | IN_PERSON | WHATSAPP
  direction       String   // OUTBOUND | INBOUND
  subject         String?
  body            String?
  agentId         String?  // user id of rep
  outcome         String?  // ANSWERED | NO_ANSWER | INTERESTED | NOT_INTERESTED | CONVERSION
  durationSec     Int?
  scheduledAt     DateTime?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign        CrmCampaign? @relation(fields: [campaignId], references: [id])

  @@index([customerId, occurredAt])
  @@index([campaignId])
}

model CrmDeal {
  id              String   @id @default(cuid())
  customerId      String
  title           String
  description     String?
  valueMinor      Int
  currency        String   @default("GHS")
  stage           String   @default("LEAD") // LEAD | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  probability     Float    @default(0.1) // 0..1
  expectedCloseAt DateTime?
  ownerAgentId    String?  // user id (sales agent or account manager)
  lostReason      String?
  closedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, stage])
  @@index([stage])
}

model CustomerHealthScore {
  id              String   @id @default(cuid())
  customerId      String   @unique
  score           Float    // 0..100
  tier            String   @default("OK") // RISK | OK | GOOD | CHAMPION
  factorsJson     String   // { retention, spend, engagement, complaints, ratings }
  computedAt      DateTime @default(now())

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tier])
}

model CustomerJourneyStage {
  id              String   @id @default(cuid())
  customerId      String
  stage           String   // AWARENESS | CONSIDERATION | ONBOARDING | ACTIVE | RENEWAL | CHURN_RISK | CHURNED | REACTIVATED
  enteredAt       DateTime @default(now())
  exitedAt        DateTime?

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, stage])
}

// ============================================================================
//  CLEANING PROTOCOL ENGINE
// ============================================================================

model CleaningProtocol {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?
  serviceTypeId   String?
  surfaceCode     String?  // MARBLE | GRANITE | WOOD | LAMINATE | LEATHER | FABRIC | GLASS | TILES | ELECTRONICS | VEHICLES | INDUSTRIAL
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  estimatedDurationMin Int
  safetyNotes     String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  serviceType     ServiceType? @relation(fields: [serviceTypeId], references: [id])
  steps           ProtocolStep[]
  executions      ProtocolExecution[]

  @@index([serviceTypeId, isActive])
  @@index([surfaceCode])
}

model ProtocolStep {
  id              String   @id @default(cuid())
  protocolId      String
  order           Int
  title           String
  description     String?
  expectedDurationMin Int
  requiresPhoto   Boolean  @default(false)
  chemicalNotes   String?  // free-form; specific items linked via ProtocolStepChemical
  ppeRequired     String?
  equipmentRequired String?
  qualityChecklist String? // JSON array of checklist items
  createdAt       DateTime @default(now())

  protocol        CleaningProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  chemicals       ProtocolStepChemical[]
  stepExecutions  ProtocolStepExecution[]

  @@index([protocolId, order])
}

model ProtocolStepChemical {
  id              String   @id @default(cuid())
  stepId          String
  itemId          String
  quantityPerSqM  Float?
  notes           String?

  step            ProtocolStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([stepId, itemId])
}

model ProtocolExecution {
  id              String   @id @default(cuid())
  bookingId       String?
  protocolId      String
  workerId        String
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  status          String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ABANDONED | DEVIATION
  complianceScore Float?   // 0..100 — % of steps followed exactly
  deviationNotes  String?
  customerFeedback String?
  createdAt       DateTime @default(now())

  protocol        CleaningProtocol @relation(fields: [protocolId], references: [id])
  worker          Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  stepExecutions  ProtocolStepExecution[]

  @@index([protocolId, status])
  @@index([workerId])
}

model ProtocolStepExecution {
  id              String   @id @default(cuid())
  executionId     String
  stepId          String
  startedAt       DateTime?
  completedAt     DateTime?
  status          String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED | FAILED
  photoUrl        String?
  notes           String?
  deviationFlag   Boolean  @default(false)
  deviationReason String?
  checklistResultsJson String? // JSON: [{ item, passed }]
  actualDurationMin Int?

  execution       ProtocolExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step            ProtocolStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

// ============================================================================
//  TRAINING LMS
// ============================================================================

model Course {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  description     String?
  category        String   // SAFETY | SURFACE | CHEMICAL | EQUIPMENT | SOFT_SKILLS | COMPLIANCE
  difficulty      String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT
  estimatedHours  Float    @default(1)
  isActive        Boolean  @default(true)
  version         Int      @default(1)
  prereqCourseIds String?  // comma-separated course ids
  coverImageUrl   String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessons         Lesson[]
  exams           Exam[]
  enrollments     Enrollment[]
  certifications  Certification[]

  @@index([category, isActive])
}

model Lesson {
  id              String   @id @default(cuid())
  courseId        String
  order           Int
  title           String
  contentMarkdown String?
  contentUrl      String?
  videoUrl        String?
  durationMin     Int      @default(15)
  passingScorePercent Float @default(70)
  isRequired      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]

  @@index([courseId, order])
}

model Exam {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  description     String?
  passingScorePercent Float @default(70)
  timeLimitMin    Int      @default(60)
  maxAttempts     Int      @default(3)
  questionsJson   String   // [{ id, text, type, options, correctAnswer, points }]
  isFinal         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts        ExamAttempt[]

  @@index([courseId])
}

model Enrollment {
  id              String   @id @default(cuid())
  workerId        String
  courseId        String
  status          String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED | DROPPED | EXPIRED
  enrolledAt      DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  dueAt           DateTime?
  finalScorePercent Float?
  certificateId   String?
  assignedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id])
  lessonProgress  LessonProgress[]
  examAttempts    ExamAttempt[]

  @@unique([workerId, courseId])
  @@index([workerId, status])
  @@index([courseId, status])
}

model LessonProgress {
  id              String   @id @default(cuid())
  enrollmentId    String
  lessonId        String
  status          String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED | FAILED
  startedAt       DateTime?
  completedAt     DateTime?
  timeSpentMin    Int      @default(0)
  attempts        Int      @default(0)
  scorePercent    Float?
  lastPositionSec Int      @default(0)

  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson          Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model ExamAttempt {
  id              String   @id @default(cuid())
  enrollmentId    String
  examId          String
  attemptNumber   Int
  startedAt       DateTime @default(now())
  submittedAt     DateTime?
  scorePercent    Float?
  passed          Boolean  @default(false)
  answersJson     String?  // [{ questionId, selectedAnswer }]
  timeSpentMin    Int?

  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  exam            Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([examId, passed])
}

model Certification {
  id              String   @id @default(cuid())
  workerId        String
  courseId        String
  certificateNumber String @unique
  issuedAt        DateTime @default(now())
  expiresAt       DateTime?
  status          String   @default("ACTIVE") // ACTIVE | EXPIRED | REVOKED
  issuedBy        String?
  metadataJson    String?

  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id])
  recertifications RecertificationSchedule[]

  @@index([workerId, status])
  @@index([expiresAt])
}

model RecertificationSchedule {
  id              String   @id @default(cuid())
  certificationId String
  dueAt           DateTime
  reminderSentAt  DateTime?
  status          String   @default("SCHEDULED") // SCHEDULED | REMINDED | COMPLETED | OVERDUE
  notes           String?
  createdAt       DateTime @default(now())

  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([dueAt, status])
}

// ============================================================================
//  SUPPLY CHAIN MANAGEMENT
// ============================================================================

model Supplier {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  contactName     String?
  email           String?
  phone           String?
  address         String?
  paymentTerms    String   @default("NET_30") // NET_15 | NET_30 | NET_60 | COD
  taxId           String?
  rating          Float    @default(0) // 0..5
  isActive        Boolean  @default(true)
  onboardedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  performanceRecords SupplierPerformance[]

  @@index([isActive])
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  code            String   @unique
  supplierId      String
  warehouseCode   String   @default("MAIN")
  status          String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | SENT | PARTIALLY_RECEIVED | RECEIVED | INVOICED | PAID | CANCELLED
  expectedDeliveryAt DateTime?
  actualDeliveryAt DateTime?
  subtotalMinor   Int      @default(0)
  taxMinor        Int      @default(0)
  shippingMinor   Int      @default(0)
  totalMinor      Int      @default(0)
  currency        String   @default("GHS")
  notes           String?
  placedBy        String?
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  lines           PurchaseOrderLine[]
  receipts        GoodsReceipt[]

  @@index([supplierId, status])
  @@index([status])
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  itemId          String
  quantity        Int
  receivedQty     Int      @default(0)
  unitCostMinor   Int
  totalMinor      Int
  notes           String?

  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item            InventoryItem  @relation(fields: [itemId], references: [id])
  receiptLines    GoodsReceiptLine[]

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  code            String   @unique
  purchaseOrderId String
  receivedAt      DateTime @default(now())
  receivedBy      String?
  qualityCheckPassed Boolean @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id])
  lines           GoodsReceiptLine[]

  @@index([purchaseOrderId])
}

model GoodsReceiptLine {
  id              String   @id @default(cuid())
  goodsReceiptId  String
  poLineId        String
  itemId          String
  quantityReceived Int
  quantityRejected Int     @default(0)
  rejectionReason String?
  notes           String?

  goodsReceipt    GoodsReceipt    @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poLine          PurchaseOrderLine @relation(fields: [poLineId], references: [id], onDelete: Cascade)
  item            InventoryItem   @relation(fields: [itemId], references: [id])

  @@index([goodsReceiptId])
}

model SupplierPerformance {
  id              String   @id @default(cuid())
  supplierId      String
  period          String   // e.g. "2026-07"
  onTimeDeliveryRate Float // 0..1
  qualityAcceptanceRate Float
  averageLeadTimeDays Float
  totalOrdersMinor Int
  totalOrders     Int
  createdAt       DateTime @default(now())

  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, period])
}

model Warehouse {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  address         String?
  managerId       String?  // user id
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  transfers       WarehouseTransfer[] @relation("FromTransfers")
  transfersTo     WarehouseTransfer[] @relation("ToTransfers")

  @@index([isActive])
}

model WarehouseTransfer {
  id              String   @id @default(cuid())
  code            String   @unique
  fromWarehouseCode String
  toWarehouseCode String
  status          String   @default("REQUESTED") // REQUESTED | APPROVED | IN_TRANSIT | RECEIVED | CANCELLED
  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  shippedAt       DateTime?
  receivedAt      DateTime?
  requestedBy     String?
  approvedBy      String?
  notes           String?
  linesJson       String   // [{ itemId, quantity }]

  fromWarehouse   Warehouse @relation("FromTransfers", fields: [fromWarehouseCode], references: [code])
  toWarehouse     Warehouse @relation("ToTransfers", fields: [toWarehouseCode], references: [code])

  @@index([status])
}

// ============================================================================
//  FLEET MANAGEMENT
// ============================================================================

model Vehicle {
  id              String   @id @default(cuid())
  plateNumber     String   @unique
  make            String
  model           String
  year            Int
  type            String   // MOTORBIKE | SEDAN | VAN | TRUCK | TRICYCLE
  status          String   @default("ACTIVE") // ACTIVE | MAINTENANCE | RETIRED | IMPounded
  color           String?
  vin             String?
  mileageKm       Int      @default(0)
  fuelLevelPercent Float   @default(100)
  nextServiceKm   Int?
  nextServiceDate DateTime?
  insuranceExpiry DateTime?
  roadworthyExpiry DateTime?
  assignedWorkerId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments     VehicleAssignment[]
  maintenance     VehicleMaintenance[]
  fuelLogs        FuelLog[]
  inspections     VehicleInspection[]

  @@index([status])
  @@index([assignedWorkerId])
}

model VehicleAssignment {
  id              String   @id @default(cuid())
  vehicleId       String
  workerId        String
  assignedAt      DateTime @default(now())
  returnedAt      DateTime?
  purpose         String?
  startingMileageKm Int?
  endingMileageKm Int?
  notes           String?

  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, assignedAt])
}

model VehicleMaintenance {
  id              String   @id @default(cuid())
  vehicleId       String
  scheduledAt     DateTime?
  completedAt     DateTime?
  type            String   // OIL_CHANGE | TIRES | BRAKES | INSPECTION | REPAIR | ROUTINE
  description     String?
  costMinor       Int      @default(0)
  odometerKm      Int?
  vendorName      String?
  performedBy     String?
  status          String   @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  notes           String?
  createdAt       DateTime @default(now())

  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, status])
}

model FuelLog {
  id              String   @id @default(cuid())
  vehicleId       String
  at              DateTime @default(now())
  liters          Float
  costMinor       Int
  odometerKm      Int
  fuelType        String   @default("PETROL") // PETROL | DIESEL | ELECTRIC_KWH
  stationName     String?
  filledBy        String?
  notes           String?

  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, at])
}

model VehicleInspection {
  id              String   @id @default(cuid())
  vehicleId       String
  inspectedAt     DateTime @default(now())
  inspectedBy     String?
  passed          Boolean  @default(true)
  defectsJson     String?  // [{ component, severity, description }]
  photoUrls       String?
  nextInspectionDue DateTime?
  notes           String?

  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, inspectedAt])
}

// ============================================================================
//  ENTERPRISE CONTRACTS (B2B)
// ============================================================================

model EnterpriseContract {
  id              String   @id @default(cuid())
  contractNumber  String   @unique
  customerId      String
  title           String
  description     String?
  status          String   @default("DRAFT") // DRAFT | SENT | NEGOTIATING | ACTIVE | EXPIRING | EXPIRED | TERMINATED | RENEWED
  startDate       DateTime
  endDate         DateTime
  slaTier         String   @default("STANDARD") // BASIC | STANDARD | PREMIUM | ENTERPRISE
  autoRenew       Boolean  @default(false)
  renewalPeriodMonths Int?
  signedAt        DateTime?
  signedBy        String?
  accountManagerId String? // user id
  totalContractValueMinor Int @default(0)
  currency        String   @default("GHS")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines           ContractLine[]
  milestones      ContractMilestone[]
  billingSchedule ContractBillingSchedule[]
  slas            ContractSLA[]
  performance     ContractPerformance[]

  @@index([customerId, status])
  @@index([status])
  @@index([endDate])
}

model ContractLine {
  id              String   @id @default(cuid())
  contractId      String
  serviceTypeId   String
  billingCycle    String   @default("MONTHLY") // WEEKLY | MONTHLY | QUARTERLY | ANNUALLY
  unitPriceMinor  Int
  minimumVolume   Int      @default(0)
  includedVolume  Int      @default(0)
  overagePriceMinor Int
  notes           String?

  contract        EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceType     ServiceType        @relation(fields: [serviceTypeId], references: [id])

  @@index([contractId])
}

model ContractMilestone {
  id              String   @id @default(cuid())
  contractId      String
  name            String
  description     String?
  dueAt           DateTime
  completedAt     DateTime?
  status          String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | OVERDUE
  notes           String?

  contract        EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, status])
}

model ContractBillingSchedule {
  id              String   @id @default(cuid())
  contractId      String
  periodStart     DateTime
  periodEnd       DateTime
  amountMinor     Int
  status          String   @default("SCHEDULED") // SCHEDULED | INVOICED | PAID | OVERDUE | CANCELLED
  invoiceId       String?
  invoicedAt      DateTime?
  paidAt          DateTime?

  contract        EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, status])
}

model ContractSLA {
  id              String   @id @default(cuid())
  contractId      String
  metric          String   // RESPONSE_TIME | RESOLUTION_TIME | QUALITY_SCORE | COMPLETION_RATE
  targetHours     Int?
  targetPercent   Float?
  penaltyPercent  Float    @default(0)
  notes           String?

  contract        EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model ContractPerformance {
  id              String   @id @default(cuid())
  contractId      String
  period          String   // e.g. "2026-07"
  slaComplianceRate Float
  qualityScore    Float
  utilizationRate Float
  issuesCount     Int      @default(0)
  penaltiesMinor  Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())

  contract        EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, period])
}

// ============================================================================
//  WORKFLOW ENGINE (configurable + AI-ready)
// ============================================================================

model WorkflowDefinition {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String?
  version         Int      @default(1)
  entityType      String   // BOOKING | CONTRACT | WORKER | DEAL | PROTOCOL | generic
  statesJson      String   // [{ key, label, isInitial, isFinal, color }]
  transitionsJson String   // [{ from, to, key, label, guardConditions, actions }]
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instances       WorkflowInstance[]
  actions         WorkflowAction[]
  triggers        WorkflowTrigger[]

  @@index([entityType, isActive])
}

model WorkflowInstance {
  id              String   @id @default(cuid())
  definitionId    String
  entityType      String
  entityId        String
  currentState    String
  contextJson     String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  lastTransitionAt DateTime?

  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id])
  transitionLogs  WorkflowTransitionLog[]

  @@index([entityType, entityId])
  @@index([currentState])
}

model WorkflowTransitionLog {
  id              String   @id @default(cuid())
  instanceId      String
  fromState       String?
  toState         String
  transitionKey   String
  actorId         String?
  actorType       String?
  metadataJson    String?
  at              DateTime @default(now())

  instance        WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, at])
}

model WorkflowAction {
  id              String   @id @default(cuid())
  definitionId    String
  transitionKey   String
  actionType      String   // WEBHOOK | AI_LLM | AI_FORECAST | AI_CLASSIFY | EMAIL | NOTIFICATION | QUEUE_JOB | UPDATE_FIELD | GATEWAY_CALL
  name            String
  configJson      String   // action-specific config (URL, prompt template, queue name, etc.)
  order           Int      @default(0)
  isAsync         Boolean  @default(false)
  timeoutSec      Int      @default(30)

  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId, transitionKey])
}

model WorkflowTrigger {
  id              String   @id @default(cuid())
  definitionId    String
  eventPattern    String   // e.g. "booking.created" or "payswap.payment_intent.succeeded"
  conditionsJson  String?  // optional CEL/JSON-logic conditions
  actionIdsJson   String?  // optional: trigger-specific actions (overrides transition actions)
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())

  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
}

// ============================================================================
//  ADVANCED ANALYTICS
// ============================================================================

model AnalyticsView {
  id              String   @id @default(cuid())
  name            String
  description     String?
  ownerId         String?
  scope           String   @default("USER") // USER | TEAM | GLOBAL
  configJson      String   // [{ widgetType, dataSource, params, layout }]
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scope, isPublic])
}

model AnalyticsReport {
  id              String   @id @default(cuid())
  name            String
  description     String?
  schedule        String   // DAILY | WEEKLY | MONTHLY | QUARTERLY
  recipientsJson  String   // array of user ids or emails
  configJson      String   // report config
  format          String   @default("PDF") // PDF | XLSX | CSV | JSON
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, nextRunAt])
}

model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  metricKey       String   // e.g. "revenue.daily", "bookings.completion_rate"
  period          String   // e.g. "2026-07-26" or "2026-W30" or "2026-07"
  periodType      String   @default("DAY") // DAY | WEEK | MONTH | QUARTER
  value           Float
  dimensionsJson  String?  // optional breakdown dimensions
  capturedAt      DateTime @default(now())

  @@unique([metricKey, period])
  @@index([metricKey, period])
}

// ============================================================================
//  BACKWARD-COMPAT RELATIONS — extend existing models with new relations
//  (Additive only; no breaking changes to existing columns)
// ============================================================================

// Customer already exists; we add new optional reverse relations
// by re-declaring fields on the existing model below. To avoid Prisma
// conflict, we use a one-to-many with the existing Customer model.
// The relation fields on the new models above reference Customer directly;
// Customer needs back-relation fields. We add them via a separate model
// "CustomerCrmRelations" that mirrors the customer id — this keeps the
// existing Customer model untouched while still being queryable.
// (See Customer.* back-relations — added in a non-conflicting way below.)

model CustomerCrmRelations {
  id              String   @id @default(cuid())
  customerId      String   @unique
  // Aggregated CRM counters for fast UI rendering
  touchpointCount Int      @default(0)
  dealCount       Int      @default(0)
  openDealValueMinor Int   @default(0)
  journeyStage    String?  // current stage
  healthScore     Float?
  healthTier      String?
  lastTouchpointAt DateTime?
  updatedAt       DateTime @updatedAt

  @@index([healthTier])
  @@index([journeyStage])
}


// ============================================================================
//  WAITLIST — sign-up flow puts users here; admin approves to create account
// ============================================================================

model WaitlistEntry {
  id              String   @id @default(cuid())
  email           String   @unique
  fullName        String
  phone           String?
  passwordHash    String   // pre-hashed at submission; used when admin approves
  requestedRole   String   @default("CUSTOMER") // CUSTOMER | WORKER | FIELD_MANAGER | SALES_AGENT
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  notes           String?  // admin notes
  reviewedBy      String?  // admin user id
  reviewedAt      DateTime?
  rejectionReason String?
  source          String   @default("WEB") // WEB | INVITE | IMPORT
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([requestedRole])
}
